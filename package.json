{
  "name": "mizan",
  "version": "0.1.1",
  "description": "Bilirkişi raporu düzeyinde işçilik alacakları hesabı: kaynaklı tablolar, parametreli hukuki tercihler, tarihli PDF rapor.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Av. Alpaslan Fatih Sözer",
  "bin": {
    "mizan": "bin/mizan.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\" \"web/tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "ornek": "node bin/mizan.ts hesapla ornekler/ornek-iscilik.yaml --cikti ornekler/cikti",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "tsc --noEmit -p web && vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "pdfmake": "0.3.11",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.4",
    "preact": "10.29.8",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
